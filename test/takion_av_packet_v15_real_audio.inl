// Real audio AV packet headers captured from a PS5 at takion v15 on 2026-09-07.
// Two interleaved streams: sub-tag 0 (main audio, Opus) and sub-tag 2 (haptics,
// pad 0). Only the header is reproduced; the payload is elided and the recorded
// total length is kept so data_size is exact.

struct v15_real_audio_case
{
	const char *name;
	uint8_t header[20];
	size_t total_size;
	uint16_t packet_index;
	uint16_t frame_index;
	uint8_t codec;
	uint8_t av_tag;
	bool is_haptics;
	uint16_t units_in_frame_total;
	uint16_t units_in_frame_fec;
	size_t data_size;
	uint16_t source_units_count;
	uint16_t fec_units_count;
	size_t unit_size;
};

